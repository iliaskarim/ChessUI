#!/usr/bin/env zsh
# Crop scholars-mate.mov to a square centered on the chess UI, then write a GIF.
#
# The recording is a full phone frame. The status bar and theme button sit above
# the chess view, so the square is centered on the status line, board, and menu.
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
cd "$root"

src="$root/scholars-mate.mov"
cropped="$root/scholars-mate-cropped.mov"
gif="$root/scholars-mate.gif"
if [[ ! -f "$src" ]]; then
  print -u2 "Missing $src. Run \`just capture scholars-mate\` first."
  exit 1
fi

frame="$(mktemp -t scholars-frame).png"
ffmpeg -y -ss 1 -i "$src" -frames:v 1 -update 1 "$frame" >/dev/null 2>&1
crop="$(python3 - "$frame" <<'PY'
import sys
from PIL import Image

image = Image.open(sys.argv[1]).convert("RGB")
width, height = image.size
pixels = image.load()
# Skip the status bar and theme button. What remains is the chess UI.
top_limit = int(height * 0.18)
points = []
for y in range(top_limit, height):
    for x in range(width):
        red, green, blue = pixels[x, y]
        if red < 245 or green < 245 or blue < 245:
            points.append((x, y))
if not points:
    raise SystemExit("Could not find the chess UI.")

xs = [point[0] for point in points]
ys = [point[1] for point in points]
pad = 40
side = max(max(xs) - min(xs), max(ys) - min(ys)) + 1 + pad * 2
if side % 2:
    side += 1
center_x = (min(xs) + max(xs)) / 2
center_y = (min(ys) + max(ys)) / 2
left = int(round(center_x - side / 2))
top = int(round(center_y - side / 2))
left -= left % 2
top -= top % 2
if left < 0 or top < 0 or left + side > width or top + side > height:
    raise SystemExit(f"Square crop {side} at {left},{top} does not fit {width}x{height}.")
print(f"{side}:{side}:{left}:{top}")
PY
)"
rm -f "$frame"

print -r -- "Crop $crop"
ffmpeg -y -i "$src" -vf "crop=${crop}" \
  -c:v libx264 -pix_fmt yuv420p -crf 18 -c:a aac -b:a 192k \
  "$cropped"

print -r -- "GIF $gif"
ffmpeg -y -i "$cropped" -filter_complex \
  "[0:v]fps=1,scale=509:509:flags=lanczos,split[a][b];[a]palettegen=stats_mode=diff[p];[b][p]paletteuse=dither=none" \
  "$gif"
print -r -- "Wrote $cropped"
print -r -- "Wrote $gif"
